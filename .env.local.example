# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only Postgres URL for scripts (data loads, scripts/build-ai-documents.mjs)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# AI chat (Scholar and Apostle modes). Hidden until one of these is set.
ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=mock               # canned replies, no key or cost (for development)
# AI_MODEL=claude-opus-5-5       # claude-sonnet-5-5 costs less
# AI_EFFORT=medium               # low | medium | high | xhigh | max
# AI_MAX_TOKENS=8000
# AI_DAILY_LIMIT_FREE=10         # questions per user per day, per mode
# AI_DAILY_LIMIT_PREMIUM=100

# Premium (Stripe). Everything stays free until PREMIUM_ENABLED=true.
# PREMIUM_ENABLED=true
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
